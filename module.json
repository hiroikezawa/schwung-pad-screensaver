{
  "id": "pad-screensaver",
  "name": "Pad Screensaver",
  "author": "Hiro Ikezawa",
  "abbrev": "PSS",
  "version": "0.1.0",
  "description": "Visual-only MIDI FX: while its screen is open, the 32 pads play ten animations (plasma, scanner, matrix rain, fire, waves, glitch, snake, gradient, life, dual scanner) that change every 10-180 s. MIDI passes through untouched.",
  "component_type": "midi_fx",
  "capabilities": {
    "chainable": true,
    "component_type": "midi_fx",
    "midi_in": true,
    "midi_out": true,
    "chain_params": [
      { "key": "interval", "name": "Interval", "type": "int", "min": 10, "max": 180, "step": 1, "default": 30 },
      { "key": "brightness", "name": "Brightness", "type": "int", "min": 5, "max": 100, "step": 1, "default": 70 },
      { "key": "speed", "name": "Speed", "type": "int", "min": 25, "max": 300, "step": 5, "default": 100 },
      { "key": "mode", "name": "Mode", "type": "enum", "options": ["random", "sequential"], "default": 0 }
    ]
  },
  "ui_chain": "ui_chain.js"
}
